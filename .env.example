# 复制为 .env 并填入真实密钥（.env 已被 .gitignore 忽略，不会提交）
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx

# ⚠️ 安全：开启局域网访问（start:lan / allowLanAccess）时，务必设置这个 token。
# 未设置时，同一局域网内任何设备都能向 Agent 下令（/message）、读媒体、控会议室。
# 建议生成随机值：node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# 局域网其他设备访问时加 token：http://<本机IP>:3721/?token=<上面的值>
BAILONGMA_API_TOKEN=

# ── 社交连接器（可选）──
# DISCORD_BOT_TOKEN=xxxxxxxxxxxxxxxx
# TELEGRAM_BOT_TOKEN=123456:ABC-xxxxxxxxxxxxxxxxxxx   # @BotFather 创建机器人拿到
# FEISHU_APP_ID=cli_xxxxxxxx
# FEISHU_APP_SECRET=xxxxxxxxxxxxxxxx
